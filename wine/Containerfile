FROM docker.io/library/debian:trixie AS base

ARG TARGETARCH
ARG WINE_VERSION="11.20"

RUN apt-get update
RUN apt-get install -y \
wget \
gpg \
xz-utils

RUN mkdir /opt/wine
RUN WINE_ARCHIVE="wine-${WINE_VERSION}-staging-tkg-amd64-wow64.tar.xz" && \
    cd /tmp && \
    wget -q "https://github.com/Kron4ek/Wine-Builds/releases/download/${WINE_VERSION}/${WINE_ARCHIVE}" \
            "https://github.com/Kron4ek/Wine-Builds/releases/download/${WINE_VERSION}/sha256sums.txt" && \
    grep " ${WINE_ARCHIVE}\$" sha256sums.txt | sha256sum -c - && \
    tar -xJf "$WINE_ARCHIVE" --strip-components=1 -C /opt/wine && \
    rm -f "$WINE_ARCHIVE" sha256sums.txt

RUN ln -s /opt/wine/bin/wine /usr/local/bin/wine

# We need box64 for arm64
COPY --chmod=0755 ./install-box64.sh /tmp/
RUN if [ "$TARGETARCH" = "arm64" ]; then /tmp/install-box64.sh; fi
RUN rm -f /tmp/install-box64.sh

# Cleanup
RUN apt-get clean
RUN rm -rf /var/lib/apt/lists/*
