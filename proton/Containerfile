FROM docker.io/library/debian:trixie@sha256:8c4733a92aacd0bcff3779eadc35a4a5147f36cb20a5fcb56504cbc740212259 AS base

ARG TARGETARCH
# renovate: datasource=github-releases depName=GloriousEggroll/proton-ge-custom
ARG GE_VERSION="11-11"

RUN apt-get update
RUN apt-get install -y \
wget

# The arm64 build is native and runs x86 Windows code through the bundled FEX
RUN mkdir /opt/proton
RUN case "$TARGETARCH" in \
      amd64) PROTON_ARCH=x86_64 ;; \
      arm64) PROTON_ARCH=aarch64 ;; \
      *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac && \
    PROTON_NAME="GE-Proton${GE_VERSION}-${PROTON_ARCH}" && \
    cd /tmp && \
    wget -q "https://github.com/GloriousEggroll/proton-ge-custom/releases/download/GE-Proton${GE_VERSION}/${PROTON_NAME}.tar.gz" \
            "https://github.com/GloriousEggroll/proton-ge-custom/releases/download/GE-Proton${GE_VERSION}/${PROTON_NAME}.sha512sum" && \
    sha512sum -c "${PROTON_NAME}.sha512sum" && \
    tar -xzf "${PROTON_NAME}.tar.gz" --strip-components=1 -C /opt/proton && \
    rm -f "${PROTON_NAME}.tar.gz" "${PROTON_NAME}.sha512sum"

# The arm64 build ships its binaries in bin-arm64 instead of bin.
# Proton 11 no longer ships a wine64 launcher there; keep the name for compatibility.
RUN if [ "$TARGETARCH" = "arm64" ]; then BIN_DIR=/opt/proton/files/bin-arm64; else BIN_DIR=/opt/proton/files/bin; fi && \
    ln -s "$BIN_DIR/wine" /usr/local/bin/wine && \
    ln -s "$BIN_DIR/wine" /usr/local/bin/wine64

# Cleanup
RUN apt-get clean
RUN rm -rf /var/lib/apt/lists/*
